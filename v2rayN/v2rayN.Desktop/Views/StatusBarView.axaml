<UserControl
    x:Class="v2rayN.Desktop.Views.StatusBarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="80"
    d:DesignWidth="1100"
    x:DataType="vms:StatusBarViewModel"
    mc:Ignorable="d">
    <Border
        MinHeight="56"
        Padding="12,8"
        Background="{DynamicResource SemiColorFill0}"
        BorderBrush="{DynamicResource SemiColorBorder}"
        BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
            <!--  Left: connection hero  -->
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <Border
                    x:Name="brdStatusOrb"
                    Width="34"
                    Height="34"
                    Background="{DynamicResource SemiColorSuccess}"
                    CornerRadius="10"
                    Opacity="0.95">
                    <PathIcon
                        x:Name="icoStatusOrb"
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="{StaticResource SemiIconBolt}"
                        Foreground="White" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock
                        x:Name="txtConnectionState"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="—"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="txtRunningServerDisplay"
                        FontSize="11"
                        Foreground="{DynamicResource SemiColorText2}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <!--  Mid: mode controls  -->
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <!--  Segmented system-proxy control (mock: 清除 / 系统代理 / 不改动 / PAC)  -->
                <ListBox
                    x:Name="lstSystemProxy"
                    MinHeight="0"
                    VerticalAlignment="Center"
                    Theme="{DynamicResource ButtonRadioGroupListBox}"
                    ToolTip.Tip="{x:Static resx:ResUI.menuSystemproxy}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="0" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBoxItem Content="{x:Static resx:ResUI.menuSystemProxyClear}" />
                    <ListBoxItem Content="{x:Static resx:ResUI.menuSystemProxySet}" />
                    <ListBoxItem Content="{x:Static resx:ResUI.menuSystemProxyNothing}" />
                    <ListBoxItem
                        x:Name="lstSystemProxyPac"
                        Content="{x:Static resx:ResUI.menuSystemProxyPac}" />
                </ListBox>

                <ComboBox
                    x:Name="cmbRoutings2"
                    MinWidth="120"
                    MaxWidth="180"
                    DisplayMemberBinding="{Binding Remarks}"
                    ItemsSource="{Binding RoutingItems}"
                    ToolTip.Tip="{x:Static resx:ResUI.menuRouting}" />

                <Button
                    x:Name="btnProcessListSetting"
                    Padding="8,4"
                    VerticalAlignment="Center"
                    Classes="Tertiary"
                    FontSize="12"
                    ToolTip.Tip="选择需要劫持流量的进程"
                    Content="{x:Static resx:ResUI.ProcessListSettingTitle}" />

                <!--  Secondary toggles: not competing with connection hero  -->
                <StackPanel
                    x:Name="spEnableTun"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <Border
                        Width="1"
                        Height="22"
                        Margin="2,0"
                        Background="{DynamicResource SemiColorBorder}" />

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource SemiColorText2}"
                        Text="{x:Static resx:ResUI.TbLegacyProtect}" />
                    <ToggleSwitch
                        x:Name="togEnableLegacyProtect"
                        VerticalAlignment="Center"
                        Theme="{DynamicResource SimpleToggleSwitch}" />

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource SemiColorText2}"
                        Text="{x:Static resx:ResUI.TbEnableTunAs}" />
                    <ToggleSwitch
                        x:Name="togEnableTun"
                        VerticalAlignment="Center"
                        Theme="{DynamicResource SimpleToggleSwitch}" />
                    <Button
                        x:Name="btnTunHealthCheck"
                        Padding="8,4"
                        VerticalAlignment="Center"
                        Classes="Tertiary"
                        FontSize="11"
                        Content="{x:Static resx:ResUI.BtnHealthCheck}" />
                </StackPanel>

                <!--  Hidden: keep name for any code that may look up the old ComboBox  -->
                <ComboBox
                    x:Name="cmbSystemProxy"
                    Width="0"
                    Height="0"
                    IsVisible="False"
                    IsHitTestVisible="False">
                    <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxyClear}" />
                    <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxySet}" />
                    <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxyNothing}" />
                    <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxyPac}" />
                </ComboBox>
            </StackPanel>

            <!--  Right: inbound + rates  -->
            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="16">
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock
                        x:Name="txtInboundDisplay"
                        FontSize="11"
                        Foreground="{DynamicResource SemiColorText1}"
                        TextAlignment="Right" />
                    <TextBlock
                        x:Name="txtInboundLanDisplay"
                        FontSize="11"
                        Foreground="{DynamicResource SemiColorText2}"
                        TextAlignment="Right" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock
                        x:Name="txtSpeedProxyDisplay"
                        FontSize="11"
                        FontWeight="SemiBold"
                        TextAlignment="Right" />
                    <TextBlock
                        x:Name="txtSpeedDirectDisplay"
                        FontSize="11"
                        Foreground="{DynamicResource SemiColorText2}"
                        TextAlignment="Right" />
                </StackPanel>
                <!--  Keep for binding parity / tooltip source  -->
                <TextBlock
                    x:Name="txtRunningInfoDisplay"
                    Width="0"
                    Height="0"
                    IsVisible="False" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
