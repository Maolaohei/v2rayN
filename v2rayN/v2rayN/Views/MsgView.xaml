<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.MsgView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:TypeArguments="vms:MsgViewModel"
    Style="{StaticResource ViewGlobal}"
    mc:Ignorable="d">
    <!--  Nested inside parent ContentCard — white surface, quiet tools  -->
    <Border Background="{DynamicResource DesignCardBrush}" Padding="2,0,2,2">
    <DockPanel Margin="0">
            <DockPanel
                Margin="0,0,0,8"
                DockPanel.Dock="Top"
                LastChildFill="True">
                <ToggleButton
                    x:Name="togCollapseLog"
                    Width="28"
                    Height="28"
                    Margin="6,0,0,0"
                    Padding="0"
                    DockPanel.Dock="Right"
                    ToolTip="折叠/展开日志"
                    IsChecked="True"
                    Style="{StaticResource MaterialDesignFlatToggleButton}"
                    Foreground="{DynamicResource DesignInk3Brush}">
                    <materialDesign:PackIcon
                        x:Name="icoCollapseLog"
                        Width="18"
                        Height="18"
                        Kind="ChevronDown" />
                </ToggleButton>

                <WrapPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Border
                        Width="160"
                        Height="30"
                        Margin="0,0,8,0"
                        Padding="8,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource DesignChipWellBrush}"
                        CornerRadius="8">
                        <TextBox
                            x:Name="txtMsgFilter"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            materialDesign:HintAssist.Hint="{x:Static resx:ResUI.MsgFilterTitle}"
                            materialDesign:HintAssist.Foreground="{DynamicResource DesignInk3Brush}"
                            materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                            materialDesign:TextFieldAssist.HasClearButton="True"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="{DynamicResource DesignInkBrush}"
                            Style="{StaticResource DefTextBox}"
                            TextChanged="TxtMsgFilter_TextChanged"
                            KeyDown="TxtMsgFilter_KeyDown" />
                    </Border>

                    <Button
                        x:Name="btnCopy"
                        Width="28"
                        Height="28"
                        Margin="0,0,4,0"
                        AutomationProperties.Name="{x:Static resx:ResUI.menuMsgViewCopyAll}"
                        Style="{StaticResource QuietToolButton}"
                        ToolTip="{x:Static resx:ResUI.menuMsgViewCopyAll}">
                        <materialDesign:PackIcon VerticalAlignment="Center" Kind="ContentCopy" Width="16" Height="16" />
                    </Button>
                    <Button
                        x:Name="btnClear"
                        Width="28"
                        Height="28"
                        Margin="0,0,10,0"
                        AutomationProperties.Name="{x:Static resx:ResUI.menuMsgViewClear}"
                        Style="{StaticResource QuietToolButton}"
                        ToolTip="{x:Static resx:ResUI.menuMsgViewClear}">
                        <materialDesign:PackIcon
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource DesignDangerBrush}"
                            Kind="Delete"
                            Width="16"
                            Height="16" />
                    </Button>

                    <!--  Real switches + short labels: readable in narrow pane  -->
                    <StackPanel
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource StdFontSize-1}"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"
                            Text="自动刷新" />
                        <ToggleButton
                            x:Name="togAutoRefresh"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Static resx:ResUI.TbAutoRefresh}"
                            IsChecked="True"
                            Style="{StaticResource MaterialDesignSwitchToggleButton}"
                            ToolTip="{x:Static resx:ResUI.TbAutoRefresh}"
                            materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="{DynamicResource DesignSelectBrush}"
                            materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="{DynamicResource DesignChipWellBrush}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource StdFontSize-1}"
                            Foreground="{DynamicResource DesignInk3Brush}"
                            Text="滚到底" />
                        <ToggleButton
                            x:Name="togScrollToEnd"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Static resx:ResUI.TbAutoScrollToEnd}"
                            IsChecked="True"
                            Style="{StaticResource MaterialDesignSwitchToggleButton}"
                            ToolTip="{x:Static resx:ResUI.TbAutoScrollToEnd}"
                            materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="{DynamicResource DesignSelectBrush}"
                            materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="{DynamicResource DesignChipWellBrush}" />
                    </StackPanel>
                </WrapPanel>
            </DockPanel>

            <TextBox
                x:Name="txtMsg"
                MinHeight="80"
                VerticalAlignment="Stretch"
                AcceptsReturn="True"
                Background="Transparent"
                BorderThickness="0"
                FontSize="{DynamicResource StdFontSize-1}"
                HorizontalScrollBarVisibility="Auto"
                IsReadOnly="True"
                IsReadOnlyCaretVisible="True"
                IsUndoEnabled="False"
                TextAlignment="Left"
                TextWrapping="Wrap"
                UndoLimit="0"
                VerticalScrollBarVisibility="Visible">
                <TextBox.ContextMenu>
                    <ContextMenu Style="{StaticResource DefContextMenu}">
                        <MenuItem
                            x:Name="menuMsgViewSelectAll"
                            Header="{x:Static resx:ResUI.menuMsgViewSelectAll}" />
                        <MenuItem
                            x:Name="menuMsgViewCopy"
                            Header="{x:Static resx:ResUI.menuMsgViewCopy}" />
                        <MenuItem
                            x:Name="menuMsgViewCopyAll"
                            Header="{x:Static resx:ResUI.menuMsgViewCopyAll}" />
                        <Separator />
                        <MenuItem
                            x:Name="menuMsgViewClear"
                            Header="{x:Static resx:ResUI.menuMsgViewClear}" />
                    </ContextMenu>
                </TextBox.ContextMenu>
            </TextBox>
        </DockPanel>
    </Border>
</reactiveui:ReactiveUserControl>
